# FPL Signals server environment. Copy to .env.signals and fill in.
# Keys only ever live here (or in the shell), never in code or config.
PORT=8090
ODDS_API_KEY=
FPL_LEAGUE_ID=391690
FPL_TEAM_ID=301830
# Optional: set RUN_SNAPSHOTS=1 only after installing Playwright,
# otherwise the snapshot moments are logged but nothing runs.
# RUN_SNAPSHOTS=
# The Scout (pop-up assistant, 12 Nov 2026). Both tokens are made on the
# server and written into this file and Jeevs's .env unseen (README-SERVER).
#   FPL_SCOUT_MCP_TOKEN: Jeevs's key to The Scout's tools (POST /mcp).
#   FPL_ASSISTANT_TOKEN: this server's key to Jeevs's /fpl-assistant routes.
# FPL_SCOUT_MCP_TOKEN=
# FPL_ASSISTANT_TOKEN=
# FPL_ASSISTANT_URL=http://jeevs:8080/fpl-assistant
